NODE_ENV = development
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]
ENABLE_MOCK_AUTH=true
MOCK_USERS='[{"id":"some_identifier","email":"email@domain.local","password_hash":"user_password_hash","full_name":"user first and last name","role":"ENCODER","permissions":["READ_CATALOG","UPDATE_STOCK"]}]'