<div class="card-container">
  <div class="card-header">
    <h1 class="card-title"><%= title %></h1>
    <a href="/categories"><button type="button" class="btn">Cancel</button></a>
  </div>

  <form action="/categories/<%= category.id %>" method="post" class="card-form">
    <input
      type="text"
      name="id"
      id="id"
      value="<%= category.id %>"
      style="display: none"
    />
    <div class="form-group">
      <label for="category_name">Name (Category ID: <%= category.id %>)</label>
      <input
        type="text"
        name="category_name"
        id="category_name"
        value="<%= category.category_name %>"
      />
    </div>

    <div class="form-group">
      <label for="parent_id">Ancestor path: (Parent Selector)</label>
      <select name="parent_id" id="parent_id">
        <option value="">No parent (Top-level category)</option>
        <% categories.forEach(cat => { %>

        <% if (Number(cat.id) === Number(category.parent_id)) { %>
        <option
          value="<%= cat.id %>"
          title="Category ID: <%= cat.id %>"
          selected
        >
          <%= cat.path %>
        </option>
        <% } else { %>
        <option value="<%= cat.id %>" title="Category ID: <%= cat.id %>">
          <%= cat.path %>
        </option>
        <% } %>

        <% }); %>
      </select>
    </div>

    <%- include("../partials/form-errors") %>

    <button type="submit" class="btn btn-rect btn-tall btn-action-go">
      Update
    </button>
  </form>
  <pre style="position: absolute"></pre>
</div>
