<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Inventory System</title>
    <style>
      #login-root {
        color: #9ca3af;
        background-color: #14171d;
      }
    </style>
    <link rel="stylesheet" href="/css/index.css" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body id="login-root">
    <%- include("../partials/header") %>
    <main class="main__main-wrapper" id="login-main">
      <div class="login__auth-card">
        <h2>Sign In</h2>
        <p>Please enter your credentials to access the inventory system</p>

        <form action="/login" method="post" class="login__form">
          <input type="hidden" name="redirectTo" value="<%= redirectTo %>" />

          <div class="login__form-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              name="email"
              id="email"
              class="form-control"
              placeholder="e.g., encoder@inventory.local"
              required="true"
              autofocus="true"
            />
          </div>

          <div class="login__form-group">
            <label for="password">Password</label>
            <input
              type="password"
              name="password"
              id="password"
              class="form-control"
              placeholder="••••••••"
              required="true"
            />
          </div>

          <button type="submit" class="login__login-btn">Sign In</button>
        </form>

        <% if (error) { %>
        <div class="login__error" role="alert"><%= error %></div>
        <% } %>

        <% if(process.env.ENABLE_MOCK_AUTH === "true") { %>
        <div class="login__mock-credentials-box">
          <p>Development Quick Login Credentials:</p>
          <ul class="login__credentials-list">
            <li class="login__credentials-item">
              <span class="login__credentials-item-span"
                >Username:
                <span><code>encoder@inventory.local</code></span></span
              >
            </li>
            <li class="login__credentials-item">
              <span class="login__credentials-item-span"
                >Password:<code>1234</code></span
              >
            </li>
            <li class="login__credentials-item">
              <span class="login__credentials-item-span"
                >Role:<code>ENCODER</code></span
              >
            </li>
          </ul>
        </div>
        <% } %>
      </div>
    </main>
    <%# include("../partials/footer")  %>
  </body>
</html>
