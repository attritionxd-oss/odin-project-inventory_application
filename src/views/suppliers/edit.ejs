<div class="card-container">
  <div class="card-header">
    <h1 class="card-title">Supplier: <%= title %></h1>
    <div class="actions-group">
      <a href="/suppliers" class="btn">Back</a>
    </div>
  </div>

  <form action="/suppliers/<%= supplier.id %>" method="post" class="card-form">
    <div class="form-group">
      <label for="supplier_name">Name</label>
      <input
        type="text"
        name="supplier_name"
        id="supplier_name"
        value="<%= supplier.supplier_name %>"
      />
      <% if (errors) { %>
      <div class="form-error-string" role="error"><%= errors %></div>
      <% } %>
    </div>

    <div class="form-group">
      <label for="contact_email">Email</label>
      <input
        type="text"
        name="contact_email"
        id="contact_email"
        value="<%= supplier.contact_email %>"
      />
    </div>

    <div class="form-group">
      <label for="created_at">Created</label>
      <input
        type="text"
        name="created_at"
        id="created_at"
        value="<%= supplier.created_at__formatted %>"
        disabled="true"
        readonly="true"
        title="<%= supplier.created_at %>"
      />
    </div>

    <div class="form-group">
      <label for="deleted_at">Deleted</label>
      <input
        type="text"
        name="deleted_at"
        id="deleted_at"
        value="<%= supplier.deleted_at__formatted %>"
        disabled="true"
        readonly="true"
        title="<%= supplier.deleted_at %>"
      />
    </div>
    <div class="form-group">
      <% if (currentUser.role === "ADMIN" || currentUser.role === "ANALYST") {
      %> <% if (supplier.deleted_at !== null) { %>
      <button
        form="restoreForm"
        type="submit"
        class="btn btn-rect btn-tall btn-primary"
      >
        Restore
      </button>
      <%}%>
      <%}%>
      <button type="submit" class="btn btn-rect btn-tall btn-action-go">
        Update
      </button>
    </div>
  </form>
  <% if (currentUser.role === "ADMIN" || currentUser.role === "ANALYST") {
      %>
  <% if (supplier.deleted_at !== null) { %>
  <form
    id="restoreForm"
    action="/suppliers/<%= supplier.id %>/restore"
    method="post"
    class="inline-form"
  ></form>
  <%}%>
  <%}%>
</div>
