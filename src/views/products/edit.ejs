<div class="card-container">
  <div class="card-header">
    <h1 class="card-title"><%= title %></h1>
    <a href="/products"><button type="button" class="btn">Cancel</button></a>
  </div>

  <form action="/products/<%= product.id %>" method="post" class="card-form">
    <div class="form-group">
      <label for="product_name">Name</label>
      <input
        type="text"
        name="product_name"
        id="product_name"
        value="<%= product.product_name %>"
      />
    </div>

    <!-- prettier-ignore -->
    <div class="form-group">
      <label for="product_description">Description</label>
      <textarea
        name="product_description"
        id="product_description"
        style="min-height: 80px; resize: vertical"
      ><%- product.product_description %></textarea>
    </div>

    <div class="form-group">
      <label for="brand_id">Brand</label>
      <select name="brand_id" id="brand_id">
        <option value="">None</option>
        <% brands.forEach(brand => { %>

        <% if (Number(brand.id) === Number(product.brand_id)) { %>
        <option value="<%= brand.id %>" selected>
          <%= brand.brand_name %>
        </option>
        <% } else { %>
        <option value="<%= brand.id %>"><%= brand.brand_name %></option>
        <% } %>

        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="category_id">Category</label>
      <select name="category_id" id="category_id">
        <option value="">No parent/ancestor</option>
        <% categories.forEach(category => { %>

        <% if (Number(category.id) === Number(product.category_id)) { %>
        <option value="<%= category.id %>" selected>
          <%= category.path %>
        </option>
        <% } else { %>
        <option value="<%= category.id %>"><%= category.path %></option>
        <% } %>

        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="supplier_id">Supplier</label>
      <select name="supplier_id" id="supplier_id">
        <option value="">None</option>
        <% suppliers.forEach(supplier => { %>

        <% if (Number(supplier.id) === Number(product.supplier_id)) { %>
        <option value="<%= supplier.id %>" selected>
          <%= supplier.supplier_name %>
        </option>
        <% } else { %>
        <option value="<%= supplier.id %>">
          <%= supplier.supplier_name %>
        </option>
        <% } %>

        <% }) %>
      </select>
    </div>

    <%- include("../partials/form-errors") %>

    <div class="form-group">
      <% if (!!product.deleted_at) { %>
      <button
        form="restoreForm"
        type="submit"
        class="btn btn-rect btn-tall btn-primary"
      >
        Restore
      </button>
      <% } %>
      <button type="submit" class="btn btn-rect btn-tall btn-action-go">
        Update
      </button>
    </div>
  </form>
  <% if (!!product.deleted_at) { %>
  <form
    id="restoreForm"
    action="/products/<%= product.id %>/restore"
    method="post"
    class="inline-form"
  ></form>
  <% } %>
</div>
